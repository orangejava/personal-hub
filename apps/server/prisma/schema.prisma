  messageId       String    @map("message_id") @db.Uuid
  contentId       String?   @map("content_id") @db.Uuid
  titleSnapshot   String    @map("title_snapshot") @db.VarChar(200)
  excerptSnapshot String    @map("excerpt_snapshot") @db.VarChar(2000)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  message         AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("ai_message_references")
}

model AiQuotaReservation {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId       String               @map("account_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  status          AiReservationStatus  @default(PENDING)
  reservedAmount  BigInt               @map("reserved_amount")
  settledAmount   BigInt               @default(0) @map("settled_amount")
  messageId       String?              @map("message_id") @db.Uuid
  jobId           String?              @map("job_id") @db.Uuid
  requestId       String?              @map("request_id") @db.Uuid
  expiresAt       DateTime             @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  account         AiQuotaAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AiMessage[]
  jobs            AiGenerationJob[]

  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("ai_quota_reservations")
}

model AiUsageRecord {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?    @map("user_id") @db.Uuid
  ownerType     AiOwnerType @map("owner_type")
  ownerId       String     @map("owner_id") @db.Uuid
  toolType      AiToolCode @map("tool_type")
  modelId       String?    @map("model_id") @db.Uuid
  inputTokens   Int        @default(0) @map("input_tokens")
  outputTokens  Int        @default(0) @map("output_tokens")
  platformCost  Int        @default(0) @map("platform_cost")
  providerCost  Int?       @map("provider_cost")
  messageId     String?    @map("message_id") @db.Uuid
  jobId         String?    @map("job_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  model         AiModel?   @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ownerType, ownerId, createdAt])
  @@map("ai_usage_records")
}

model AiGenerationJob {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                 @map("user_id") @db.Uuid
  toolType           AiToolCode             @map("tool_type")
  status             AiGenerationJobStatus  @default(QUEUED)
  progress           Int                    @default(0)
  modelId            String                 @map("model_id") @db.Uuid
  modelKeySnapshot   String                 @map("model_key_snapshot") @db.VarChar(120)
  prompt             String
  negativePrompt     String?                @map("negative_prompt")
  params             Json?
  seed               Int?
  parentJobId        String?                @map("parent_job_id") @db.Uuid
  resultFileIds      Json                   @default("[]") @map("result_file_ids")
  errorCode          String?                @map("error_code") @db.VarChar(80)
  errorSummary       String?                @map("error_summary") @db.VarChar(300)
  idempotencyKey     String                 @map("idempotency_key") @db.VarChar(128)
  reservationId      String?                @map("reservation_id") @db.Uuid
  startedAt          DateTime?              @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?              @map("finished_at") @db.Timestamptz(6)
  cancelRequestedAt  DateTime?              @map("cancel_requested_at") @db.Timestamptz(6)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  model              AiModel                @relation(fields: [modelId], references: [id], onDelete: Restrict)
  reservation        AiQuotaReservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assets             AiAsset[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("ai_generation_jobs")
}

model AiAssetFolder {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String          @map("owner_id") @db.Uuid
  name      String          @db.VarChar(80)
  parentId  String?         @map("parent_id") @db.Uuid
  sortOrder Int             @default(0) @map("sort_order")
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    AiAssetFolder?  @relation("AssetFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  AiAssetFolder[] @relation("AssetFolderTree")
  assets    AiAsset[]

  @@index([ownerId, deletedAt, createdAt])
  @@map("ai_asset_folders")
}

model AiAsset {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String         @map("owner_id") @db.Uuid
  fileId       String?        @map("file_id") @db.Uuid
  folderId     String?        @map("folder_id") @db.Uuid
  type         AiAssetType
  source       AiAssetSource  @default(GENERATED)
  status       AiAssetStatus  @default(SAVED)
  title        String         @db.VarChar(160)
  prompt       String?
  modelId      String?        @map("model_id") @db.Uuid
  width        Int?
  height       Int?
  durationMs   Int?           @map("duration_ms")
  seed         Int?
  params       Json?
  sourceJobId  String?        @map("source_job_id") @db.Uuid
  favoriteAt   DateTime?      @map("favorite_at") @db.Timestamptz(6)
  lastUsedAt   DateTime?      @map("last_used_at") @db.Timestamptz(6)
  trashedAt    DateTime?      @map("trashed_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  file         FileAsset?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  folder       AiAssetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  model        AiModel?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  sourceJob    AiGenerationJob? @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)

  @@index([ownerId, deletedAt, createdAt])
  @@index([folderId])
  @@map("ai_assets")
}
