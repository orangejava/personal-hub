generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum RoleCode {
  MEMBER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum DataScope {
  OWN
  ALL
}

enum MenuScope {
  PUBLIC
  WORKSPACE
  ADMIN
  AI
}

enum MenuType {
  DIRECTORY
  INTERNAL
  EXTERNAL
}

enum AuditCategory {
  AUTH
  RBAC
  SECURITY
  QUOTA
  SYSTEM
  CONTENT
  FILE
}

enum ContentType {
  MARKDOWN
  RICH_TEXT
  BOOKLET
  PDF
  WORD
  LINK
  PROJECT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentVisibility {
  PUBLIC
  LOGIN
  PRIVATE
}

enum ContentSourceType {
  MANUAL
  UPLOAD
  IMPORT
}

enum ImportSource {
  JUEJIN
  LOCAL
  MANUAL
}

enum ImportRestriction {
  NONE
  PRIVATE_UNTIL_LICENSED
}

enum ContentVersionReason {
  PUBLISH_SNAPSHOT
  RESTORE_SNAPSHOT
  IMPORT_SNAPSHOT
}

enum AuditResult {
  SUCCEEDED
  FAILED
}

enum AiQuotaTransactionType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
  ADJUSTMENT
}

/// 身份账号的唯一来源。首版通过 roleId 建立单角色关联，未来多角色再引入关联表。
model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 始终保存小写规范化邮箱；迁移中的 CHECK 约束保证数据库不会接受未规范化值。
  email                   String                   @unique @map("email_normalized") @db.VarChar(320)
  passwordHash            String                   @map("password_hash")
  status                  UserStatus               @default(PENDING_VERIFICATION)
  roleId                  String                   @map("role_id") @db.Uuid
  authVersion             Int                      @default(1) @map("auth_version")
  permissionVersion       Int                      @default(1) @map("permission_version")
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  emailChangedAt          DateTime?                @map("email_changed_at") @db.Timestamptz(6)
  /// Bootstrap 创建的临时密码必须在后续 Auth 登录流程中强制修改。
  mustChangePassword      Boolean                  @default(false) @map("must_change_password")
  nickname                String?                  @db.VarChar(80)
  avatarFileId            String?                  @map("avatar_file_id") @db.Uuid
  bio                     String?                  @db.VarChar(500)
  links                   Json?
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  role                    Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailChangeRequests     EmailChangeRequest[]
  totpFactor              TotpFactor?
  auditLogs               AuditLog[]               @relation("AuditActor")
  quotaAccount            AiQuotaAccount?
  systemConfigUpdates     SystemConfig[]
  authoredContents        Content[]               @relation("ContentAuthor")
  deletedContents         Content[]               @relation("ContentDeletedBy")
  createdTags             Tag[]
  contentVersions         ContentVersion[]
  favorites               Favorite[]
  readingRecords          ReadingRecord[]

  @@index([roleId, status])
  @@map("users")
}

/// 系统角色可由 seed 重放；受保护角色的最后一个 active 用户约束由事务用例执行。
model Role {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          RoleCode         @unique
  label         String           @db.VarChar(80)
  isSystem      Boolean          @default(true) @map("is_system")
  isProtected   Boolean          @default(false) @map("is_protected")
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users         User[]
  permissions   RolePermission[]
  aiEntitlement AiEntitlement?

  @@map("roles")
}

/// 权限目录由受控 seed 写入；数据库 CHECK 约束禁止自由权限码。
model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(80)
  group       String           @db.VarChar(80)
  label       String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]
  menus       MenuPermission[]

  @@map("permissions")
}

/// 动作权限和数据范围分离，首版只允许 OWN / ALL。
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  dataScope    DataScope  @map("data_scope")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  deviceName        String?        @map("device_name") @db.VarChar(160)
  userAgent         String?        @map("user_agent") @db.VarChar(512)
  ipHash            String?        @map("ip_hash") @db.VarChar(128)
  ipMasked          String?        @map("ip_masked") @db.VarChar(64)
  lastActiveAt      DateTime       @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?        @map("revoked_reason") @db.VarChar(120)
  authVersion       Int            @map("auth_version")
  permissionVersion Int            @map("permission_version")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String         @map("session_id") @db.Uuid
  tokenHash         String         @unique @map("token_hash") @db.VarChar(128)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  rotatedAt         DateTime?      @map("rotated_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?        @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  session           AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken?  @relation("RefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          RefreshToken[] @relation("RefreshRotation")

  @@index([sessionId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeRequest {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  newEmail   String    @map("new_email_normalized") @db.VarChar(320)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("email_change_requests")
}

model TotpFactor {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  secretCiphertext String             @map("secret_ciphertext")
  enabledAt        DateTime?          @map("enabled_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?          @map("last_used_at") @db.Timestamptz(6)
  disabledAt       DateTime?          @map("disabled_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes    TotpRecoveryCode[]

  @@map("totp_factors")
}

model TotpRecoveryCode {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factorId   String     @map("factor_id") @db.Uuid
  codeHash   String     @unique @map("code_hash") @db.VarChar(128)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  factor     TotpFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@index([factorId, consumedAt])
  @@map("totp_recovery_codes")
}

/// 菜单仅控制导航展示；实际接口仍必须由 Guard 和数据范围校验保护。
model Menu {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope        MenuScope
  type         MenuType
  name         String           @db.VarChar(120)
  /// 对应前端 locale `menu.${localeKey}`；为空时回落到 name / routeKey。
  localeKey    String?          @map("locale_key") @db.VarChar(160)
  icon         String?          @db.VarChar(80)
  parentId     String?          @map("parent_id") @db.Uuid
  routeKey     String?          @unique @map("route_key") @db.VarChar(160)
  externalUrl  String?          @map("external_url") @db.VarChar(2048)
  openInNewTab Boolean          @default(false) @map("open_in_new_tab")
  sortOrder    Int              @default(0) @map("sort_order")
  visible      Boolean          @default(true)
  enabled      Boolean          @default(true)
  isSystem     Boolean          @default(true) @map("is_system")
  /// 仅后台可见的管理备注，不进入公开导航。
  remark       String?          @db.VarChar(500)
  version      Int              @default(1)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent       Menu?            @relation("MenuTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Menu[]           @relation("MenuTree")
  permissions  MenuPermission[]

  @@index([scope, parentId, sortOrder])
  @@map("menus")
}

/// 类型化运营配置；value 必须经过注册表 DTO 校验，禁止存放密钥。
model SystemConfig {
  key       String   @id @db.VarChar(80)
  group     String   @db.VarChar(80)
  value     Json
  isPublic  Boolean  @default(true) @map("is_public")
  version   Int      @default(1)
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updater   User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([group])
  @@map("system_configs")
}

/// HTTP 写接口幂等记录。唯一范围见 Canonical 数据模型；过期后由定时任务清理。
model IdempotencyRecord {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectType         String   @map("subject_type") @db.VarChar(40)
  subjectIdOrHash     String   @map("subject_id_or_hash") @db.VarChar(128)
  httpMethod          String   @map("http_method") @db.VarChar(16)
  pathHash            String   @map("path_hash") @db.VarChar(64)
  idempotencyKey      String   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint  String   @map("request_fingerprint") @db.VarChar(64)
  responseStatus      Int      @map("response_status")
  responseBody        Json     @map("response_body")
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([subjectType, subjectIdOrHash, httpMethod, pathHash, idempotencyKey], map: "idempotency_records_subject_key")
  @@index([expiresAt])
  @@map("idempotency_records")
}

model MenuPermission {
  menuId       String     @map("menu_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([menuId, permissionId])
  @@map("menu_permissions")
}

/// 安全、权限和额度等事实记录仅追加；detail 仅允许写入经过白名单筛选的 JSON。
model AuditLog {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category   AuditCategory
  action     String        @db.VarChar(120)
  actorId    String?       @map("actor_id") @db.Uuid
  targetType String?       @map("target_type") @db.VarChar(80)
  targetId   String?       @map("target_id") @db.Uuid
  requestId  String?       @map("request_id") @db.Uuid
  ipHash     String?       @map("ip_hash") @db.VarChar(128)
  result     AuditResult   @default(SUCCEEDED)
  detail     Json?
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// M1 只落地角色权益和验证赠额金额，模型/工具授权细节由后续 AI 模块扩展。
model AiEntitlement {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId                  String   @unique @map("role_id") @db.Uuid
  verificationGrantAmount BigInt   @default(10000) @map("verification_grant_amount")
  rules                   Json?    @map("rules")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  role                    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("ai_entitlements")
}

/// 用户额度余额由账本派生；后续预占/结算必须使用条件原子更新而非进程内锁。
model AiQuotaAccount {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @unique @map("user_id") @db.Uuid
  availableAmount BigInt               @default(0) @map("available_amount")
  reservedAmount  BigInt               @default(0) @map("reserved_amount")
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    AiQuotaTransaction[]

  @@map("ai_quota_accounts")
}

model AiQuotaTransaction {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String                 @map("account_id") @db.Uuid
  type                  AiQuotaTransactionType
  amount                BigInt
  availableBalanceAfter BigInt                 @map("available_balance_after")
  reservedBalanceAfter  BigInt                 @map("reserved_balance_after")
  source                String                 @db.VarChar(80)
  idempotencyKey        String?                @unique @map("idempotency_key") @db.VarChar(128)
  requestId             String?                @map("request_id") @db.Uuid
  detail                Json?
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  account               AiQuotaAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("ai_quota_transactions")
}

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @db.VarChar(80)
  slug      String     @unique @db.VarChar(80)
  parentId  String?    @map("parent_id") @db.Uuid
  sortOrder Int        @default(0) @map("sort_order")
  enabled   Boolean    @default(true)
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  contents  Content[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String       @db.VarChar(80)
  normalizedName  String       @unique @map("normalized_name") @db.VarChar(80)
  slug            String       @unique @db.VarChar(80)
  createdBy       String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator         User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  contents        ContentTag[]

  @@map("tags")
}

model Content {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               ContentType
  title              String?            @db.VarChar(200)
  summary            String?
  authorId           String             @map("author_id") @db.Uuid
  categoryId         String?            @map("category_id") @db.Uuid
  status             ContentStatus      @default(DRAFT)
  visibility         ContentVisibility  @default(PRIVATE)
  sourceType         ContentSourceType  @default(MANUAL) @map("source_type")
  importSource       ImportSource?      @map("import_source")
  importRestriction  ImportRestriction  @default(NONE) @map("import_restriction")
  coverFileId        String?            @map("cover_file_id") @db.Uuid
  primaryFileId      String?            @map("primary_file_id") @db.Uuid
  externalUrl        String?            @map("external_url") @db.VarChar(2048)
  extra              Json?
  isFeatured         Boolean            @default(false) @map("is_featured")
  viewCount          Int                @default(0) @map("view_count")
  wordCount          Int                @default(0) @map("word_count")
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(6)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?            @map("deleted_by") @db.Uuid
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  author             User               @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  deletedByUser      User?              @relation("ContentDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  body               ContentBody?
  versions           ContentVersion[]
  chapters           ContentChapter[]
  tags               ContentTag[]
  favorites          Favorite[]
  readingRecords     ReadingRecord[]
  viewDays           ContentViewDay[]

  @@index([status, visibility, deletedAt, publishedAt])
  @@index([authorId, deletedAt, updatedAt])
  @@index([categoryId, status, visibility])
  @@map("contents")
}

model ContentBody {
  contentId        String   @id @map("content_id") @db.Uuid
  markdownSource   String?  @map("markdown_source")
  editorDocument   Json?    @map("editor_document")
  renderedHtml     String?  @map("rendered_html")
  toc              Json?
  renderVersion    Int      @default(1) @map("render_version")
  content          Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("content_bodies")
}

model ContentVersion {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId       String                @map("content_id") @db.Uuid
  snapshotReason  ContentVersionReason  @map("snapshot_reason")
  markdownSource  String?               @map("markdown_source")
  editorDocument  Json?                 @map("editor_document")
  renderedHtml    String?               @map("rendered_html")
  toc             Json?
  createdBy       String                @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  content         Content               @relation(fields: [contentId], references: [id], onDelete: Cascade)
  creator         User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([contentId, createdAt])
  @@map("content_versions")
}

model ContentChapter {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId               String    @map("content_id") @db.Uuid
  title                   String    @db.VarChar(200)
  chapterOrder            Int       @map("chapter_order")
  objectKey               String?   @map("object_key") @db.VarChar(512)
  toc                     Json?
  wordCount               Int?      @map("word_count")
  estimatedReadingSeconds Int?      @map("estimated_reading_seconds")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  content                 Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  readingRecords          ReadingRecord[]

  @@unique([contentId, chapterOrder])
  @@map("content_chapters")
}

model ContentTag {
  contentId String  @map("content_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([contentId, tagId])
  @@map("content_tags")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([userId, contentId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model ReadingRecord {
  userId                   String          @map("user_id") @db.Uuid
  contentId                String          @map("content_id") @db.Uuid
  chapterId                String?         @map("chapter_id") @db.Uuid
  contentProgressPercent   Float           @default(0) @map("content_progress_percent")
  chapterProgressPercent   Float?          @map("chapter_progress_percent")
  lastReadAt               DateTime        @default(now()) @map("last_read_at") @db.Timestamptz(6)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content                  Content         @relation(fields: [contentId], references: [id], onDelete: Cascade)
  chapter                  ContentChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@id([userId, contentId])
  @@index([userId, lastReadAt])
  @@map("reading_records")
}

model ContentViewDay {
  contentId    String   @map("content_id") @db.Uuid
  subjectHash  String   @map("subject_hash") @db.VarChar(128)
  viewDate     DateTime @map("view_date") @db.Date
  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([contentId, subjectHash, viewDate])
  @@map("content_view_days")
}
