# 这是本地开发模板，不是生产模板。
# 生产 Compose 请复制仓库根 `.env.prod.example` 为 `.env.prod`；
# 不要把本文件直接复制到服务器，因为这里使用 localhost、开发数据库和 Mailpit。
# 本地启动：cp apps/server/.env.example apps/server/.env.local

# 服务
NODE_ENV=development
PORT=3001
# 允许带 Cookie 的前端 Origin，逗号分隔：用户端 :8000 + 管理端 :8001
# 生产同站可留空，Cookie 鉴权回退 PUBLIC_APP_ORIGIN；HTTP CORS 在 NODE_ENV=production 时关闭
CORS_ORIGIN=http://localhost:8000,http://localhost:8001
# 验证/重置邮件里的用户端根地址，不要写成管理端
PUBLIC_APP_ORIGIN=http://localhost:8000
# 本地与生产 HTTP 首版都不使用 Secure Cookie；上 HTTPS 后改为 true。
COOKIE_SECURE=false

# PostgreSQL / Redis（由 compose.dev.yml 暴露至 localhost）
DATABASE_URL=postgresql://personal_hub:personal_hub_dev_password@localhost:5432/personal_hub?schema=public
REDIS_URL=redis://:personal_hub_redis_dev_password@localhost:6379
REDIS_KEY_PREFIX=ph:dev

# Auth 阶段才会使用；现在仍必须是足够长的本地私密随机值，禁止提交生产值
JWT_ACCESS_SECRET=replace-with-a-local-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-local-secret-at-least-32-characters

# 本地 MinIO（仅 S3 兼容模拟，生产使用腾讯 COS）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=personal_hub_minio
MINIO_SECRET_KEY=personal_hub_minio_dev_secret
MINIO_BUCKET=personal-hub-dev

# 本地 Mailpit；真实 SMTP 时替换为 smtp.qq.com 等服务
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=Personal Hub <noreply@localhost>

# 仅容器内 bootstrap:super-admin 命令读取；不要提交真实生产值或在 Web 端暴露。
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_TEMP_PASSWORD=ReplaceWithAOneTimePassword!1

# AI 文本 Provider。默认 fake；本地 stub 或真实 Key 再切 openai_compatible
AI_TEXT_PROVIDER=fake
# AI_OPENAI_BASE_URL=http://127.0.0.1:4010/v1
# AI_OPENAI_API_KEY=sk-local-stub
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_OPENAI_TIMEOUT_MS=60000
