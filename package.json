{
  "name": "personal-hub",
  "version": "0.1.0",
  "private": true,
  "description": "个人知识中台 + 内容管理平台 + AI 工具箱",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:react": "pnpm --filter user-web dev",
    "dev:user": "pnpm --filter user-web dev",
    "dev:user:mock": "pnpm --filter user-web dev:mock",
    "dev:admin": "pnpm --filter admin-web dev",
    "dev:admin:mock": "pnpm --filter admin-web dev:mock",
    "dev:web": "turbo dev --filter=user-web --filter=admin-web",
    "dev:web:mock": "turbo run dev:mock --filter=user-web --filter=admin-web",
    "dev:server": "pnpm --filter server dev",
    "build": "turbo build",
    "build:react": "pnpm --filter user-web build",
    "build:user": "pnpm --filter user-web build",
    "build:admin": "pnpm --filter admin-web build",
    "build:server": "pnpm --filter server build",
    "lint": "turbo lint",
    "lint:server": "pnpm --filter server lint",
    "typecheck": "turbo typecheck",
    "typecheck:server": "pnpm --filter server typecheck",
    "test:server": "pnpm --filter server test",
    "format": "prettier --write .",
    "sync:booklets": "pnpm --filter user-web sync:booklets",
    "import:agent-booklets": "python3 apps/user-web/src/scripts/import-external-agent-booklets.py && pnpm sync:booklets",
    "deploy:server": "bash scripts/deploy-server.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
