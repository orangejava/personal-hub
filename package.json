{
  "name": "personal-hub",
  "version": "0.1.0",
  "private": true,
  "description": "个人知识中台 + 内容管理平台 + AI 工具箱",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:react": "pnpm --filter react-web dev",
    "build": "turbo build",
    "build:react": "pnpm --filter react-web build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "sync:booklets": "pnpm --filter react-web sync:booklets",
    "import:agent-booklets": "python3 apps/react-web/src/scripts/import-external-agent-booklets.py && pnpm sync:booklets",
    "deploy:server": "bash scripts/deploy-server.sh"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
