# 复制为 .env.prod（已 gitignore）后填写部署机真实值。不要提交。
# 启动：docker compose --env-file .env.prod -f compose.prod.yml up --build
# Compose 用这份文件做 ${VAR} 插值并注入 server / server-worker / postgres / redis。

# 生产同站 Origin。用户端 /、管理端 /admin、API /api/v1 共用它。
PUBLIC_APP_ORIGIN=https://REPLACE_WITH_SITE_ORIGIN
# 留空：Cookie 鉴权只认 PUBLIC_APP_ORIGIN。HTTP CORS 在 NODE_ENV=production 时本就不开启。
CORS_ORIGIN=

POSTGRES_DB=personal_hub
POSTGRES_USER=personal_hub
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
DATABASE_URL=postgresql://personal_hub:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/personal_hub?schema=public

REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
REDIS_KEY_PREFIX=ph:prod

JWT_ACCESS_SECRET=REPLACE_WITH_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_REFRESH_SECRET_AT_LEAST_32_CHARS

# 当前 Nest schema 仍要求这组变量；生产对象存储切 COS 前先占位，不要指向公网 MinIO。
MINIO_ENDPOINT=http://127.0.0.1:9
MINIO_ACCESS_KEY=replace-minio-access
MINIO_SECRET_KEY=replace-minio-secret
MINIO_BUCKET=personal-hub-prod

MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
MAIL_FROM=Personal Hub <noreply@localhost>
