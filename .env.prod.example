# 复制为 .env.prod（已 gitignore）后填写。不要提交真实值。
# 人话填空表：docs/deploy/prod-env-worksheet.md
# 启动：见 docs/deploy/prod-startup-order.md
#   docker compose --env-file .env.prod -f compose.prod.yml up --build
# 生成密码/密钥：在服务器执行多次 `openssl rand -hex 32`，每个变量使用不同结果。
# 不要把生成结果写回本示例文件或提交 Git。

# ── 现在就能用（compose.prod.yml 会插值）────────────────

# 首版填公网 IP；有 HTTPS 后改成 https://你的域名。不要填写末尾斜杠。
PUBLIC_APP_ORIGIN=http://REPLACE_WITH_PUBLIC_IPV4
# 生产同站留空。Cookie 鉴权回退 PUBLIC_APP_ORIGIN。
CORS_ORIGIN=
# 当前首版使用公网 IP + HTTP，必须为 false；切换 HTTPS 后改为 true。
COOKIE_SECURE=false

POSTGRES_DB=personal_hub
POSTGRES_USER=personal_hub
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
DATABASE_URL=postgresql://personal_hub:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/personal_hub?schema=public

REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
REDIS_KEY_PREFIX=ph:prod

JWT_ACCESS_SECRET=REPLACE_WITH_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_REFRESH_SECRET_AT_LEAST_32_CHARS

# 生产填腾讯云 COS（变量名仍是 MINIO_*）。完整桶名含 APPID。
# 你的桶地址为 *.cos.ap-shanghai.myqcloud.com，因此地域基础 endpoint 是：
MINIO_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
MINIO_ACCESS_KEY=REPLACE_WITH_CAM_SECRET_ID
MINIO_SECRET_KEY=REPLACE_WITH_CAM_SECRET_KEY
MINIO_BUCKET=REPLACE_WITH_COS_BUCKET_NAME_AND_APPID

# 真实 SMTP。QQ 邮箱示例：smtp.qq.com / 465 / 16 位授权码。
# 不要把 SMTP_PASSWORD 写入 Git；本地或服务器 .env.prod 才填写。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_FULL_EMAIL_ADDRESS
SMTP_PASSWORD=REPLACE_WITH_SMTP_AUTHORIZATION_CODE
SMTP_SECURE=true
MAIL_FROM=Personal Hub <REPLACE_WITH_VERIFIED_SENDER>

# ── 启动命令使用 / 可选真实 AI ──────────────────────────

# bootstrap 命令使用；不由 Compose 自动写入数据库
SUPER_ADMIN_EMAIL=REPLACE_WITH_OWNER_EMAIL
# SUPER_ADMIN_TEMP_PASSWORD=REPLACE_WITH_ONE_TIME_OWNER_PASSWORD

# 默认 Fake；确认厂商兼容 OpenAI Chat Completions SSE 后，填写下面全部变量并取消注释。
# AI_TEXT_PROVIDER=openai_compatible
# AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_OPENAI_API_KEY=你的 OpenRouter API Key
# AI_OPENAI_MODEL=OpenRouter 中复制的 Model ID
# AI_OPENAI_TIMEOUT_MS=60000
